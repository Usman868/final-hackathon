# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/maintainiq

# JWT
JWT_ACCESS_SECRET=your_super_strong_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_super_strong_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI (OpenAI or Gemini – choose one)
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Optional Redis (bonus)
REDIS_URL=redis://127.0.0.1:6379

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Organization (used on QR labels)
ORG_NAME=MaintainIQ Demo Organization


# Email (optional – without SMTP, emails are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MaintainIQ <noreply@maintainiq.local>
